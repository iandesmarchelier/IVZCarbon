# Usá una contraseña aleatoria hexadecimal (sin caracteres reservados en URLs).
CARBON_DB_PASSWORD=
CARBON_ENV=local
# Hash scrypt de la contraseña inicial del usuario demo (backend.security.hash_password).
CARBON_BOOTSTRAP_PASSWORD_HASH=
# Sin Docker: configurar en el entorno del proceso Python.
# CARBON_DATABASE_URL=postgresql://usuario:password@localhost:5432/carbon
